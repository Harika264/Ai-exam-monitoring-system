# npm 10.9.x has an arborist bug ("Cannot read properties of null (reading
# 'edgesOut')") when resolving vitest's nested optional-peer set on Windows.
# Legacy peer resolution avoids that code path. The affected peers (vite/vitest/
# @types/node) are compatible in practice — this is a tooling workaround, not a
# real dependency conflict. Keeps local and Vercel installs consistent.
legacy-peer-deps=true
